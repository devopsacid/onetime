# Managed by Ansible (onetime role). Based on deploy/nginx.conf.example.
# Logging is OFF on purpose: the request paths contain secret ids.

# http context: also covers server blocks that set no access_log of their own (for example a default server in nginx.conf).
access_log off;

server {
    listen 80;
    listen [::]:80;
    server_name {{ onetime_domain }};
    access_log off;
    error_log /var/log/nginx/onetime-error.log crit;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
{% if onetime_nginx_http2_directive | bool %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ onetime_domain }};

    ssl_certificate     {{ onetime_nginx_certificate }};
    ssl_certificate_key {{ onetime_nginx_certificate_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log off;
    error_log /var/log/nginx/onetime-error.log crit;
    server_tokens off;

    # Derived from onetime_max_file_bytes ({{ onetime_max_file_bytes | int }}: largest blob {{ onetime_file_blob_bytes }} bytes),
    # or onetime_max_body_bytes. 30 s between two reads of the body is enough on a slow line.
    client_max_body_size {{ onetime_proxy_body_bytes | int }};
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 15s;
    keepalive_timeout 5s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://{{ '[' ~ onetime_listen_host ~ ']' if ':' in onetime_listen_host else onetime_listen_host }}:{{ onetime_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The app never reads client IPs or forwarding headers, so none are sent.
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 3s;
        # The app's upload timeout plus 10 s (onetime_proxy_timeout, or derived from onetime_max_file_bytes).
        proxy_read_timeout {{ onetime_proxy_timeout_seconds | int }}s;
        proxy_send_timeout {{ onetime_proxy_timeout_seconds | int }}s;
        proxy_buffering on;
        proxy_cache off;
    }
}
