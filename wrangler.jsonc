{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onetimepass",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onetime",
      "database_id": "20cbacad-c40a-4e7b-9a0e-3203078ecb3b",
      "migrations_dir": "migrations"
    }
  ],
  // Request logs would record secret ids, so they stay off.
  "observability": { "enabled": false }
}
