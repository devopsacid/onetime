# Written by cloud-init (deploy/terraform/modules/vm-bootstrap). Same content as the Ansible role's template.
#
# NO `log` directive on purpose: Caddy writes access logs only when `log` is present, and the request
# paths contain secret ids. Without it Caddy still writes handler errors (logger http.log.error, e.g. "upstream refused"
# while the app restarts) with the full request URI and the client IP, and TLS handshake errors (http.stdlib) with
# client IPs. Both are excluded below.
{
	log default {
		exclude http.log.error http.stdlib
	}
}

${domain} {
%{ if tls_internal ~}
	tls internal
%{ endif ~}
	reverse_proxy 127.0.0.1:8080

	# Refuse bodies over the largest blob plus headroom before they reach the app: derived from max_file_bytes
	# (${max_file_bytes}: largest blob ${blob_bytes} bytes), or max_body_bytes. Caddy sets no read or upstream timeout by
	# default, so the app's own upload timeout applies.
	request_body {
		max_size ${max_body_bytes}
	}

	encode zstd gzip
	header -Server
}
