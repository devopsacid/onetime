# nginx in front of onetime. Put this in /etc/nginx/conf.d/onetime.conf (http context) and replace the host name and certificate paths.
# Get the certificate with your usual tool (certbot, acme.sh). Plain http only redirects.
#
# Logging is OFF on purpose: the request paths contain secret ids.
#  - access_log off
#  - error_log at "crit": error lines at lower levels include the request line, with the id.
# The global error_log in nginx.conf (outside http) must be set to crit as well; nginx's default writes at "error".
# Other server blocks (the distribution's default site, the nginx image's conf.d/default.conf) keep their own access
# log, and a request with an unknown Host header or a plain IP lands there. Remove them, or set `access_log off;` in
# the http context. Tested: with the image's default.conf removed, no request line was logged.

server {
    listen 80;
    listen [::]:80;
    server_name onetime.example.com;
    access_log off;
    error_log /var/log/nginx/onetime-error.log crit;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name onetime.example.com;

    ssl_certificate     /etc/letsencrypt/live/onetime.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/onetime.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log off;
    error_log /var/log/nginx/onetime-error.log crit;
    server_tokens off;

    # Body limit and proxy timeouts follow ONETIME_MAX_FILE_BYTES. The largest body is the blob of the largest file
    # (262,562 bytes for the default 262144); take the blob plus 3 % rounded up to the next 100 KiB, and as proxy
    # timeout the app's upload timeout plus 10 s, rounded up to 10 s (the values the Ansible, Helm and Terraform code
    # derives; docs/self-hosting.md has the blob table):
    #   ONETIME_MAX_FILE_BYTES 262144 (default): client_max_body_size 300k;  proxy_read/send_timeout 80s
    #   1048576:                                 client_max_body_size 1100k; proxy_read/send_timeout 110s
    #   5242880 (ceiling):                       client_max_body_size 5300k; proxy_read/send_timeout 230s
    #   0 (files off):                           client_max_body_size 100k;  proxy_read/send_timeout 70s
    # Never below the largest blob, or the largest allowed file is refused. 30 s between two reads of the body is enough
    # on a slow line at any size; the app itself allows 68 s per upload at the default and 220 s at 5 MiB.
    client_max_body_size 300k;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 15s;
    keepalive_timeout 5s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        # The app on the same host. If nginx runs in a container on a shared Docker network, use onetime:8080.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The app never reads client IPs or forwarding headers, so none are sent.
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 3s;
        # See the body limit above: 80s for the default file limit, 230s at 5 MiB.
        proxy_read_timeout 80s;
        proxy_send_timeout 80s;
        # Responses from the app carry their own Cache-Control and security headers; do not cache or rewrite them.
        proxy_buffering on;
        proxy_cache off;
    }

    # Optional rate limiting keeps client IPs in nginx's shared memory zone (a trade-off against "no IPs are kept").
    # Off by default. To enable, in the http context:
    #   limit_req_zone $binary_remote_addr zone=onetime_create:1m rate=30r/m;
    # and inside this server block:
    #   location = /api/secrets { limit_req zone=onetime_create burst=10 nodelay; proxy_pass http://127.0.0.1:8080; }
}
