# Managed by Ansible (onetime role). Read by "docker run --env-file" or by the systemd drop-in.
{% if onetime_max_stored | string | length > 0 %}
ONETIME_MAX_STORED={{ onetime_max_stored }}
{% endif %}
ONETIME_MAX_FILE_BYTES={{ onetime_max_file_bytes | int }}
ONETIME_MAX_FILE_TTL={{ onetime_max_file_ttl | int }}
{% for name, value in onetime_env | dictsort %}
{{ name }}={{ value }}
{% endfor %}
