# Caddy in front of onetime (Caddy 2). Replace the host name.
# Caddy gets and renews the certificate by itself when the name points to this host and ports 80/443 are open.
#
# NO `log` directive on purpose: Caddy writes access logs only when `log` is present, and the request
# paths contain secret ids. Do not add it. (Caddy's own runtime messages about certificates do not contain request paths.)
#
# The global block below is needed as well. Without any `log` directive Caddy still writes handler errors (logger
# http.log.error) with the full request URI and the client IP, for example "dial tcp 127.0.0.1:8080: connect: connection
# refused" for a reveal request that arrives while the app restarts: that put /api/secrets/<id>/reveal into the journal in
# the project's test. http.stdlib carries TLS handshake errors with client IPs. Both loggers are dropped; certificate and
# start-up messages stay.
{
	log default {
		exclude http.log.error http.stdlib
	}
}

onetime.example.com {
	# The upstream is the app on the same host (systemd unit, or the compose file's 127.0.0.1:8080 port).
	# If Caddy runs in a container on a shared Docker network, use the service name instead: onetime:8080
	reverse_proxy 127.0.0.1:8080

	# The largest body is a 128 KiB file: its blob is 131,490 bytes. 140KiB (143,360) leaves headroom; never go below
	# 131,490 bytes. Caddy reads and writes without a short default timeout, and the app gives an upload 60 seconds, so no
	# timeout is needed here for 128 KiB. (Do not write 140KB: Caddy reads KB as 1,000 bytes, KiB as 1,024.)
	request_body {
		max_size 140KiB
	}

	encode zstd gzip
	header -Server

	# Optional rate limiting needs a plugin (e.g. github.com/mholt/caddy-ratelimit). It keeps client IPs in
	# Caddy's memory, which is a trade-off against "no IPs are kept". Off by default.
}
